{
  "name": "enclosure-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e"
  },
  "dependencies": {
    "solid-js": "1.9.15",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.180.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-solid": "2.11.8",
    "vitest": "5.0.0"
  }
}
